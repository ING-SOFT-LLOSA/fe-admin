{
  "name": "llosa-backoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-require-module node_modules/vitest/vitest.mjs",
    "test:run": "node --experimental-require-module node_modules/vitest/vitest.mjs --run",
    "test:ui": "node --experimental-require-module node_modules/vitest/vitest.mjs --ui",
    "dev:e2e": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true NEXT_PUBLIC_FIREBASE_API_KEY_LLOSA=demo-api-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN_LLOSA=demo-llosa.firebaseapp.com NEXT_PUBLIC_FIREBASE_PROJECT_ID_LLOSA=demo-llosa NEXT_PUBLIC_API_URL_LLOSA=http://localhost:8080 next dev",
    "emulator": "firebase emulators:start --only auth --project demo-llosa",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^24",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.3"
  }
}
